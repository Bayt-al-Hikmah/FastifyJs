{
    "name": "w3-prisma-basics",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Prisma 7 basics: models, relations, includes, and cascading deletes",
    "scripts": {
        "dev": "tsx watch db/demo.ts",
        "demo": "tsx db/demo.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "dotenv": "^18.0.10",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "prisma@7.10.1": true,
        "@prisma/engines@7.10.1": true,
        "esbuild@0.28.2": true
    }
}
