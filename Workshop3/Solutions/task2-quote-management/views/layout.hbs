<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="A persistent quote sharing application built with Fastify, Prisma, and PostgreSQL.">
        <title>{{title}} · {{appName}}</title>
        <link rel="stylesheet" href="/assets/styles.css">
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to content</a>

        <header class="site-header">
            <div class="shell header-inner">
                <a class="brand" href="/" aria-label="Quote Sharing home">
                    <span class="brand-mark" aria-hidden="true">“</span>
                    <span>{{appName}}</span>
                </a>

                <nav class="site-nav" aria-label="Main navigation">
                    <a href="/">Home</a>
                    <a href="/search">Search</a>
                    <a href="/dashboard">Dashboard</a>
                    <a class="button button-small" href="/share">Share a quote</a>
                </nav>
            </div>
        </header>

        <main id="main-content" class="shell page">
            {{{body}}}
        </main>

        <footer class="site-footer">
            <div class="shell footer-inner">
                <p>Workshop 3 · Fastify 5 · Prisma 7 · PostgreSQL</p>
                <p>&copy; {{currentYear}} Quote Sharing</p>
            </div>
        </footer>
    </body>
</html>
