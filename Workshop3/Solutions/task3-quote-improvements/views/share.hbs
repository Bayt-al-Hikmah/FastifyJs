<section class="page-heading">
    <p class="eyebrow">Add to the collection</p>
    <h1>Share a quote</h1>
    <p class="lede">
        Credit the original author, keep the wording intact, and optionally add a
        category. Every field is validated before Prisma writes the record.
    </p>
</section>

<div class="form-layout">
    <form class="card form-card" action="/share" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        {{#if submitted}}
            <div class="alert alert-success" role="status">
                <strong>Saved.</strong> Your quote is now stored in PostgreSQL.
            </div>
        {{/if}}

        {{#if error}}
            <div class="alert alert-error" role="alert">
                <strong>Please check the form.</strong> {{error}}
            </div>
        {{/if}}

        <div class="field">
            <label for="author">Original author</label>
            <input
                type="text"
                id="author"
                name="author"
                value="{{values.author}}"
                minlength="3"
                maxlength="50"
                autocomplete="off"
                required
            >
            <p class="field-hint">Between 3 and 50 characters. Whitespace-only names are rejected.</p>
        </div>

        <div class="field">
            <label for="text">Quote</label>
            <textarea
                id="text"
                name="text"
                rows="7"
                minlength="1"
                maxlength="300"
                required
            >{{values.text}}</textarea>
            <p class="field-hint">Between 1 and 300 characters. The text is escaped when displayed.</p>
        </div>

        <div class="field">
            <label for="category">Category <span class="label-note">(optional)</span></label>
            <select id="category" name="category">
                <option value="">No category</option>
                {{#each categories}}
                    <option value="{{this}}" {{#if (eq this ../values.category)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
            <p class="field-hint">Categories are stored in the nullable <code>category</code> column.</p>
        </div>

        <button class="button button-full" type="submit">Store quote</button>
    </form>

    <aside class="card side-panel">
        <h2>What happens next?</h2>
        <ul class="check-list">
            <li>The CSRF token is verified.</li>
            <li>Input is trimmed and checked against JSON Schema.</li>
            <li>Prisma inserts a row with author, text, and category.</li>
            <li>Post/Redirect/Get prevents duplicate submissions.</li>
        </ul>
        <p class="muted">
            The category field was added in a second migration:
            <code>add_quote_category</code>.
        </p>
    </aside>
</div>
