        "@fastify/view": "^12.0.1",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "dotenv": "^18.0.10",
        "fastify": "^5.12.8",
        "fastify-plugin": "^6.0.1",
        "handlebars": "^4.7.10",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "prisma@7.10.1": true,
