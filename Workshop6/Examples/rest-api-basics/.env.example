# Port used by the API and the API explorer.
PORT=3010

# Address the server binds to.
HOST=0.0.0.0

# CORS origin for /api routes. Use `true` to reflect any origin (fine for this
# public demo) or set one exact origin such as http://127.0.0.1:5173.
CORS_ORIGIN=true

# Rate limiting is applied to /api routes only.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15 minutes
