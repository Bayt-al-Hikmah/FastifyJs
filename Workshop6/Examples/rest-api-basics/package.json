{
    "name": "w6-rest-api-basics",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Workshop 6 example: a database-free Community Library REST API built with Fastify and TypeScript",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/cors": "^11.1.0",
        "@fastify/rate-limit": "^11.2.2",
        "@fastify/static": "^10.1.11",
        "dotenv": "^18.0.10",
        "fastify": "^5.12.8"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
