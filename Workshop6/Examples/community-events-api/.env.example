# PostgreSQL connection string for the dedicated workshop role/database.
DATABASE_URL="postgresql://w6_events_user:change_me@localhost:5432/w6_community_events?schema=public"

# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_bytes"

# Origin of a separate frontend (for example the Task 4 app). Leave blank when
# the bundled /app/ dashboard is the only client.
FRONTEND_ORIGIN=""

HOST="127.0.0.1"
PORT="3000"
NODE_ENV="development"
