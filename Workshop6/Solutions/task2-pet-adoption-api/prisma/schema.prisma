generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    VISITOR
    STAFF
}

enum Species {
    DOG
    CAT
    RABBIT
    OTHER
}

enum PetStatus {
    AVAILABLE
    ADOPTED
    PENDING
}

model User {
    id           Int      @id @default(autoincrement())
    name         String   @db.VarChar(80)
    email        String   @unique @db.VarChar(254)
    passwordHash String
    role         Role     @default(VISITOR)

    pets Pet[] @relation("PetShelter")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Pet {
    id          Int         @id @default(autoincrement())
    name        String      @db.VarChar(120)
    species     Species     @default(OTHER)
    age         Int         @default(0)
    description String?     @db.VarChar(2000)
    status      PetStatus   @default(AVAILABLE)
    dateAdded   DateTime    @default(now())

    shelterId Int
    shelter   User @relation("PetShelter", fields: [shelterId], references: [id], onDelete: Cascade)

    // Image metadata lives in PostgreSQL. The bytes live in private storage,
    // and the storage key is always generated by the server.
    imageStorageKey    String? @unique @db.VarChar(64)
    imageOriginalName  String? @db.VarChar(255)
    imageMimeType      String? @db.VarChar(100)
    imageExtension     String? @db.VarChar(10)
    imageSize          Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([shelterId, dateAdded])
    @@index([species, status])
    @@index([name])
}
