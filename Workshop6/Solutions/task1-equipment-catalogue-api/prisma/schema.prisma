generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    USER
    ADMIN
}

enum EquipmentCategory {
    TOOLS
    ELECTRONICS
    FURNITURE
    SPORTS
    CAMPING
    OTHER
}

enum Availability {
    AVAILABLE
    ON_LOAN
    MAINTENANCE
}

model User {
    id           Int         @id @default(autoincrement())
    name         String      @db.VarChar(80)
    email        String      @unique @db.VarChar(254)
    passwordHash String
    role         Role        @default(USER)

    equipment Equipment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Equipment {
    id           Int               @id @default(autoincrement())
    name         String            @db.VarChar(140)
    description  String?           @db.VarChar(2000)
    category     EquipmentCategory @default(OTHER)
    availability Availability     @default(AVAILABLE)
    quantity     Int               @default(1)

    ownerId Int
    owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    // Image metadata lives in PostgreSQL. The bytes live in private storage,
    // and the storage key is always generated by the server.
    imageStorageKey    String? @unique @db.VarChar(64)
    imageOriginalName  String? @db.VarChar(255)
    imageMimeType      String? @db.VarChar(100)
    imageExtension     String? @db.VarChar(10)
    imageSize          Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([ownerId, createdAt])
    @@index([category, availability])
    @@index([name])
}
