<li class="inquiry-row">
    <span class="inquiry-avatar" aria-hidden="true">{{initial}}</span>
    <div class="inquiry-body">
        <div class="inquiry-top">
            <strong>{{name}}</strong>
            <span class="inquiry-time">{{receivedAt}}</span>
        </div>
        <p class="inquiry-subject">{{subject}}</p>
        <p class="inquiry-preview">{{preview}}</p>
        <p class="inquiry-email">{{maskedEmail}}</p>
    </div>
</li>
