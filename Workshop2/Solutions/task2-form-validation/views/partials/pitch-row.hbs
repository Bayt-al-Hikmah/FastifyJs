<li class="pitch-row">
    <span class="pitch-initial" aria-hidden="true">{{initial}}</span>

    <div class="pitch-body">
        <div class="pitch-top">
            <strong>{{name}}</strong>
            <span class="pitch-time">{{receivedAt}}</span>
        </div>
        <p class="pitch-subject">{{subject}}</p>
        <p class="pitch-preview">{{preview}}</p>
        <p class="pitch-email">{{maskedEmail}}</p>
    </div>

    <span class="pitch-tag">In review</span>
</li>
