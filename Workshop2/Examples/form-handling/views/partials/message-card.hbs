<article class="guest-entry">
    <span class="author-avatar" aria-hidden="true">{{initial}}</span>

    <div class="guest-entry-body">
        <p class="guest-message">{{message}}</p>
        <p class="guest-meta">
            <span class="quote-author">{{name}}</span>
            <span class="guest-date">signed {{signedAt}}</span>
        </p>
    </div>
</article>
