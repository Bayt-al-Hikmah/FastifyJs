<article class="note-card">
    <div class="note-card-top">
        <span class="topic-chip">{{topic}}</span>
        <span class="note-time">{{readMinutes}} min read</span>
    </div>

    <h3 class="note-title">
        <a href="/notes/{{id}}">{{title}}</a>
    </h3>

    <p class="note-excerpt">{{excerpt}}</p>

    <div class="note-footer">
        <span class="note-date">{{publishedAt}}</span>
        <a class="text-link" href="/notes/{{id}}">Read note <span aria-hidden="true">→</span></a>
    </div>
</article>
