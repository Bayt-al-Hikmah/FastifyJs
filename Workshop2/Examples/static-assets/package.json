{
    "name": "workshop2-static-assets",
    "version": "1.0.0",
    "private": true,
    "description": "Serving CSS and images with @fastify/static (Workshop 2 example)",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/static": "^10.1.11",
        "@fastify/view": "^12.0.1",
        "fastify": "^5.12.8",
        "fastify-plugin": "^6.0.1",
        "handlebars": "^4.7.10"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
