<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} · Task Attachments</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0b1220;
            --surface: #111b2e;
            --surface-raised: #16243c;
            --ink: #e8eef8;
            --muted: #93a4bd;
            --line: rgba(148, 163, 184, 0.2);
            --accent: #5eead4;
            --accent-ink: #042f2e;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 2rem;
            background:
                radial-gradient(circle at 20% 10%, rgba(94, 234, 212, 0.12), transparent 30rem),
                var(--bg);
            color: var(--ink);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            line-height: 1.6;
        }

        main {
            width: min(560px, 100%);
            padding: 2.5rem;
            border: 1px solid var(--line);
            border-radius: 24px;
            background: var(--surface);
            box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9);
        }

        .status {
            display: inline-flex;
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            background: rgba(94, 234, 212, 0.12);
            color: var(--accent);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        h1 {
            margin: 1rem 0 0.6rem;
            font-size: clamp(2rem, 5vw, 2.8rem);
            line-height: 1.1;
        }

        p {
            margin: 0 0 1.5rem;
            color: var(--muted);
        }

        a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0.7rem 1.1rem;
            border-radius: 12px;
            background: var(--accent);
            color: var(--accent-ink);
            font-weight: 700;
            text-decoration: none;
        }

        a:hover {
            background: #99f6e4;
        }
    </style>
</head>
<body>
    <main>
        <span class="status">{{statusCode}}</span>
        <h1>{{title}}</h1>
        <p>{{message}}</p>
        <a href="/app/">Return to the dashboard</a>
    </main>
</body>
</html>
