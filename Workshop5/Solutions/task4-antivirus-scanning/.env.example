DATABASE_URL="postgresql://w5_task4_antivirus_scanning_user:change_me@localhost:5432/w5_task4_antivirus_scanning?schema=public"
JWT_SECRET="replace-with-the-output-of-openssl-rand-base64-32"

# Private storage root, resolved relative to the project directory.
UPLOAD_DIR="./var/uploads"

# Optional real ClamAV scanner. When CLAMAV_HOST is empty, the clearly
# labelled demo scanner (EICAR signature check) is used instead.
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Scanner limits.
SCANNER_TIMEOUT_MS="15000"
MOCK_SCAN_DELAY_MS="500"
